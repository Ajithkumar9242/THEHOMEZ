# ==============================================================================
# TheHomez Backend - Environment Configuration
# ==============================================================================

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port (1-65535)
PORT=5000

# API Routing Prefix
API_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated)
# In development, defaults to http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# MongoDB Connection String
# For host development (Windows host to Docker Mongo replica set):
MONGODB_URI=mongodb://127.0.0.1:27017/thehomez?replicaSet=rs0&directConnection=true
# For containerized backend (inside Docker network):
# MONGODB_URI=mongodb://mongo:27017/thehomez?replicaSet=rs0

# MongoDB Connection Pool & Timeouts
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=10000

# Logging Level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ==============================================================================
# Milestone 3: Authentication & Identity Configuration
# ==============================================================================

# JWT Access Token Secret & Expiration
# SECURITY REQUIREMENT:
# - In production, JWT_ACCESS_SECRET MUST be at least 32 characters long.
# - JWT_ACCESS_SECRET and OTP_PEPPER_SECRET MUST BE COMPLETELY DISTINCT.
# - Do NOT use placeholders below in production. Generate cryptographically strong random secrets.
JWT_ACCESS_SECRET=your-32-char-min-jwt-access-secret-placeholder-string-here
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token Lifecycle
# Refresh tokens are cryptographically secure random opaque strings (stored only as SHA-256 hashes in MongoDB).
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP HMAC Hashing Secret (Pepper) & Lifecycle
# OTP_PEPPER_SECRET is used for HMAC-SHA256 hashing of OTPs before database persistence.
# Never store OTPs in plaintext.
OTP_PEPPER_SECRET=your-32-char-min-otp-pepper-secret-placeholder-string-here
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# OTP Provider: 'mock' (development and test only) | 'msg91' (production)
# SECURITY REQUIREMENT:
# - 'mock' provider is strictly rejected by configuration validation in production.
# - In production, OTP_PROVIDER must be 'msg91' (or other production provider).
OTP_PROVIDER=mock

# MSG91 Provider Credentials (Optional in development; strictly required if OTP_PROVIDER=msg91)
# MSG91_AUTH_KEY=your_msg91_auth_key_placeholder
# MSG91_TEMPLATE_ID=your_msg91_template_id_placeholder

# Rate Limiting Configuration
# ARCHITECTURAL NOTE:
# - The default in-memory rate-limit store is suitable ONLY for single-instance development and testing.
# - Multi-instance / clustered production deployments MUST configure a shared distributed store (e.g. Redis).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
