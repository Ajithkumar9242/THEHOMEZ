{
  "name": "@thehomez/backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared REST API Service for TheHomez Platform",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:service-areas": "tsx src/seeds/service-areas.seed.ts",
    "seed:categories": "tsx src/seeds/categories.seed.ts",
    "seed:gate3-demo": "tsx src/scripts/seed-gate3-demo-data.ts",
    "clean": "node -e \"try { fs.rmSync('./dist', { recursive: true, force: true }); } catch (e) {}\""
  },
  "dependencies": {
    "@thehomez/shared-types": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
